# Public site origin used for canonical URLs, sitemap and OG tags
NEXT_PUBLIC_SITE_URL=https://cpschakghat.com

# Email delivery for enquiry + contact forms (Resend HTTP API — no SDK needed)
# Get a key at https://resend.com ; MAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
MAIL_FROM="CPS Chakghat Website <noreply@cpschakghat.com>"

# Optional simple password gate if an /admin area is added later
ADMIN_PASSWORD=
